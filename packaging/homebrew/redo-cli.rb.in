class RedoCli < Formula
  include Language::Python::Virtualenv

  desc "Explain why your last shell command failed and put the fix on your prompt"
  homepage "https://github.com/Roshan-Rengadurai/redo-cli"
  url "@URL@"
  sha256 "@SHA256@"
  license "MIT"

  depends_on "python@3.13"

  conflicts_with "redo", because: "both install a `redo` executable"

  def install
    virtualenv_install_with_resources
  end

  def caveats
    <<~EOS
      To capture failures automatically, install the shell hook:
        redo init
      then open a new terminal. After a command fails, type `redo`.
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/redo --version")
    ENV["REDO_HOME"] = testpath/".redo"
    ENV["NO_COLOR"] = "1"
    shell_output("#{bin}/redo run 'pyhton3 -c 1' 2>&1", 127)
    assert_match "python3 -c 1", shell_output("#{bin}/redo --no-push")
  end
end
