$ErrorActionPreference = 'Stop'
$toolsDir = Split-Path -Parent $MyInvocation.MyCommand.Definition
$venv     = Join-Path $toolsDir 'venv'
$wheel    = Join-Path $toolsDir 'redo_cli-@VERSION@-py3-none-any.whl'

Get-ChocolateyWebFile -PackageName $env:ChocolateyPackageName -FileFullPath $wheel `
  -Url '@WHEEL_URL@' -Checksum '@WHEEL_SHA256@' -ChecksumType 'sha256'

# The python3 dependency may have been installed moments ago: pick up its PATH.
Update-SessionEnvironment

# A private virtualenv. redo is pure Python with no dependencies, and a wheel
# needs no build step, so pip never touches the network.
$python = (Get-Command python -ErrorAction SilentlyContinue).Source
if (-not $python) { $python = (Get-Command py -ErrorAction Stop).Source }
& $python -m venv $venv
if ($LASTEXITCODE) { throw "creating the virtualenv failed" }
& (Join-Path $venv 'Scripts\python.exe') -m pip install --no-index --disable-pip-version-check $wheel
if ($LASTEXITCODE) { throw "installing redo failed" }

# Chocolatey shims every .exe in the package; only redo.exe should get one.
Get-ChildItem $venv -Recurse -Filter *.exe |
  Where-Object { $_.Name -ne 'redo.exe' } |
  ForEach-Object { New-Item -ItemType File -Force -Path "$($_.FullName).ignore" | Out-Null }

Write-Host ''
Write-Host 'redo is installed. Capture failures automatically with:'
Write-Host '  redo init'
Write-Host 'then open a new PowerShell window. After a command fails, type: redo'
